---
import { readingTime, type Post } from '../utils/posts';
import FormattedDate from './FormattedDate.astro';
import TagChip from './TagChip.astro';

interface Props {
  post: Post;
}
const { post } = Astro.props;
const { title, description, pubDate, emoji, color, tags, draft } = post.data;
---

<article class:list={['card', `c-${color}`]}>
  <div class="emoji" aria-hidden="true">{emoji}</div>
  <p class="meta">
    <FormattedDate date={pubDate} /> · {readingTime(post.body)} min read
    {draft && <span class="draft">draft</span>}
  </p>
  <h3><a href={`/blog/${post.id}/`}>{title}</a></h3>
  <p class="desc">{description}</p>
  {
    tags.length > 0 && (
      <ul class="tags">
        {tags.map((tag) => (
          <li>
            <TagChip tag={tag} small />
          </li>
        ))}
      </ul>
    )
  }
</article>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    width: 100%;
    padding: 22px 24px 24px;
    background: var(--accent-soft);
    border: var(--line);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow);
    transition: transform 0.18s ease, box-shadow 0.18s ease;
  }

  .card:hover {
    transform: translate(-3px, -3px);
    box-shadow: var(--shadow-lift);
  }

  .emoji {
    display: grid;
    place-items: center;
    width: 64px;
    height: 64px;
    margin-bottom: 14px;
    font-size: 2rem;
    background: var(--accent);
    border: var(--line);
    border-radius: 50%;
  }

  .card:hover .emoji {
    animation: wiggle 0.5s ease-in-out 2;
  }

  .meta {
    margin: 0 0 6px;
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--ink-soft);
  }

  .draft {
    margin-left: 6px;
    padding: 0.05em 0.6em;
    font-size: 0.8rem;
    background: var(--lemon);
    border: 2px solid var(--ink);
    border-radius: 999px;
    color: var(--ink);
  }

  h3 {
    margin: 0 0 8px;
  }

  /* make the whole card clickable via the title link */
  h3 a {
    text-decoration: none;
  }

  h3 a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  h3 a:focus-visible {
    outline: none;
  }

  .card:has(h3 a:focus-visible) {
    outline: 3px dashed var(--pink);
    outline-offset: 5px;
  }

  .desc {
    margin: 0 0 16px;
    color: var(--ink-soft);
  }

  .tags {
    list-style: none;
    margin: auto 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
</style>
