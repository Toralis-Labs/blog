---
// The little rainbow flower used as the logo (and favicon, in public/favicon.svg).
interface Props {
  size?: number;
}
const { size = 40 } = Astro.props;
---

<svg class="flower" width={size} height={size} viewBox="0 0 100 100" aria-hidden="true">
  <g style="stroke: var(--ink)" stroke-width="4">
    <circle style="fill: var(--pink)" cx="50" cy="27" r="17"></circle>
    <circle style="fill: var(--peach)" cx="71" cy="43" r="17"></circle>
    <circle style="fill: var(--mint)" cx="63" cy="68" r="17"></circle>
    <circle style="fill: var(--sky)" cx="37" cy="68" r="17"></circle>
    <circle style="fill: var(--lilac)" cx="29" cy="43" r="17"></circle>
    <circle style="fill: var(--lemon)" cx="50" cy="50" r="15"></circle>
  </g>
  <circle style="fill: var(--ink)" cx="45" cy="48" r="2.4"></circle>
  <circle style="fill: var(--ink)" cx="55" cy="48" r="2.4"></circle>
  <path style="stroke: var(--ink)" d="M45 54 Q50 59 55 54" fill="none" stroke-width="2.6" stroke-linecap="round"></path>
</svg>
