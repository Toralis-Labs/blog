---
import { slugify, tagColor } from '../utils/posts';

interface Props {
  tag: string;
  count?: number;
  small?: boolean;
}
const { tag, count, small = false } = Astro.props;
---

<a href={`/tags/${slugify(tag)}/`} class:list={['chip', `c-${tagColor(tag)}`, { small }]}>
  #{tag}
  {count !== undefined && <span class="count">{count}</span>}
</a>

<style>
  .chip {
    position: relative;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
    padding: 0.3em 0.95em;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 1.05rem;
    line-height: 1.4;
    text-decoration: none;
    background: var(--accent-soft);
    border: 2.5px solid var(--ink);
    border-radius: 999px;
    box-shadow: 3px 3px 0 var(--ink);
    transition: transform 0.15s ease, box-shadow 0.15s ease, background 0.15s ease;
  }

  .chip:hover {
    background: var(--accent);
    transform: translate(-1px, -1px) rotate(-2deg);
    box-shadow: 4px 4px 0 var(--ink);
  }

  .chip.small {
    padding: 0.05em 0.7em;
    font-size: 0.88rem;
    border-width: 2px;
    box-shadow: 2px 2px 0 var(--ink);
  }

  .count {
    display: inline-grid;
    place-items: center;
    min-width: 1.6em;
    height: 1.6em;
    padding: 0 0.3em;
    font-size: 0.85em;
    background: var(--paper);
    border: 2px solid var(--ink);
    border-radius: 999px;
  }
</style>
