---
// Floating stars, hearts and squiggles that bob around the hero picture.
---

<div class="doodles" aria-hidden="true">
  <svg class="d star" viewBox="0 0 24 24">
    <path style="fill: var(--lemon); stroke: var(--ink)" d="M12 2 9.2 8.6 2 9.2l5.5 4.8L5.8 21 12 17.3 18.2 21l-1.7-7L22 9.2l-7.2-.6Z" stroke-width="1.6" stroke-linejoin="round"></path>
  </svg>
  <svg class="d heart" viewBox="0 0 24 24">
    <path style="fill: var(--pink); stroke: var(--ink)" d="M12 21 10.6 19.7C5.4 15 2 12 2 8.4 2 5.4 4.4 3 7.4 3c1.7 0 3.4.8 4.6 2.1C13.2 3.8 14.9 3 16.6 3 19.6 3 22 5.4 22 8.4c0 3.6-3.4 6.6-8.6 11.3Z" stroke-width="1.6" stroke-linejoin="round"></path>
  </svg>
  <svg class="d sparkle" viewBox="0 0 24 24">
    <path style="fill: var(--mint); stroke: var(--ink)" d="M12 2c.8 6 4 9.2 10 10-6 .8-9.2 4-10 10-.8-6-4-9.2-10-10 6-.8 9.2-4 10-10Z" stroke-width="1.6" stroke-linejoin="round"></path>
  </svg>
  <svg class="d ring" viewBox="0 0 24 24">
    <circle style="stroke: var(--sky)" cx="12" cy="12" r="8" fill="none" stroke-width="4"></circle>
  </svg>
  <svg class="d squiggle" viewBox="0 0 40 16">
    <path style="stroke: var(--lilac)" d="M3 8q4.25-7 8.5 0t8.5 0 8.5 0 8.5 0" fill="none" stroke-width="3.5" stroke-linecap="round"></path>
  </svg>
</div>

<style>
  .doodles {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .d {
    position: absolute;
    animation: bob 4s ease-in-out infinite;
  }

  .star { width: 46px; top: 2%; left: 4%; }
  .heart { width: 40px; top: 10%; right: 2%; animation-delay: -1s; }
  .sparkle { width: 34px; bottom: 14%; left: 0; animation-delay: -2s; }
  .ring { width: 30px; bottom: 4%; right: 10%; animation-delay: -3s; }
  .squiggle { width: 56px; top: 46%; right: -4%; animation-delay: -1.5s; }
</style>
