---
import FormattedDate from '../components/FormattedDate.astro';
import TagChip from '../components/TagChip.astro';
import { readingTime, type Post } from '../utils/posts';
import BaseLayout from './BaseLayout.astro';

interface Props {
  post: Post;
  newer?: Post;
  older?: Post;
}
const { post, newer, older } = Astro.props;
const { title, description, pubDate, updatedDate, emoji, color, tags, draft } = post.data;
---

<BaseLayout title={title} description={description}>
  <article class:list={['post', `c-${color}`]}>
    <header class="post-header">
      <div class="post-emoji" aria-hidden="true">{emoji}</div>
      {draft && <p class="draft">✏️ draft: only visible while running npm run dev</p>}
      <h1>{title}</h1>
      <p class="meta">
        <FormattedDate date={pubDate} /> · {readingTime(post.body)} min read
        {
          updatedDate && (
            <>
              · updated <FormattedDate date={updatedDate} />
            </>
          )
        }
      </p>
      {
        tags.length > 0 && (
          <ul class="tags">
            {tags.map((tag) => (
              <li>
                <TagChip tag={tag} small />
              </li>
            ))}
          </ul>
        )
      }
    </header>

    <div class="prose">
      <slot />
    </div>
  </article>

  <nav class="post-nav" aria-label="More posts">
    {
      older ? (
        <a class:list={['nav-card', 'older', `c-${older.data.color}`]} href={`/blog/${older.id}/`}>
          <span class="nav-label">← older</span>
          <span class="nav-title">
            {older.data.emoji} {older.data.title}
          </span>
        </a>
      ) : (
        <span />
      )
    }
    {
      newer ? (
        <a class:list={['nav-card', 'newer', `c-${newer.data.color}`]} href={`/blog/${newer.id}/`}>
          <span class="nav-label">newer →</span>
          <span class="nav-title">
            {newer.data.emoji} {newer.data.title}
          </span>
        </a>
      ) : (
        <span />
      )
    }
  </nav>

  <p class="back"><a class="link-arrow" href="/blog/">← back to all posts</a></p>
</BaseLayout>

<style>
  .post-header {
    position: relative;
    max-width: 820px;
    margin: 64px auto 56px;
    padding: 56px clamp(20px, 5vw, 56px) 32px;
    text-align: center;
    background: var(--accent-soft);
    border: var(--line);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow);
  }

  .post-emoji {
    position: absolute;
    top: 0;
    left: 50%;
    display: grid;
    place-items: center;
    width: 88px;
    height: 88px;
    font-size: 2.8rem;
    background: var(--accent);
    border: var(--line);
    border-radius: 50%;
    box-shadow: 4px 4px 0 var(--ink);
    translate: -50% -50%;
    animation: wiggle 3s ease-in-out infinite;
  }

  .draft {
    display: inline-block;
    padding: 0.1em 0.9em;
    font-weight: 700;
    font-size: 0.9rem;
    background: var(--lemon);
    border: 2px solid var(--ink);
    border-radius: 999px;
  }

  h1 {
    margin-bottom: 0.4em;
  }

  .meta {
    font-weight: 600;
    color: var(--ink-soft);
  }

  .tags {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px;
  }

  .post-nav {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    max-width: 820px;
    margin: 80px auto 0;
  }

  .nav-card {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 16px 20px;
    text-decoration: none;
    background: var(--accent-soft);
    border: var(--line);
    border-radius: var(--radius);
    box-shadow: 4px 4px 0 var(--ink);
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }

  .nav-card:hover {
    transform: translate(-2px, -2px);
    box-shadow: 6px 6px 0 var(--ink);
  }

  .newer {
    text-align: right;
  }

  .nav-label {
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--ink-soft);
  }

  .nav-title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.15rem;
    line-height: 1.3;
  }

  .back {
    margin-top: 40px;
    text-align: center;
  }

  @media (max-width: 560px) {
    .post-nav {
      grid-template-columns: 1fr;
    }

    .newer {
      text-align: left;
    }
  }
</style>
