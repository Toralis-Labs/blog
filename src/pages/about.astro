---
import Avatar from '../components/Avatar.astro';
import { SITE, SOCIALS, type Color } from '../consts';
import BaseLayout from '../layouts/BaseLayout.astro';

// ✏️ fill these in! add or remove as many as you like.
const facts: { emoji: string; label: string; value: string; color: Color }[] = [
  { emoji: '🍓', label: 'favourite snack', value: 'fill me in', color: 'pink' },
  { emoji: '📖', label: 'currently reading', value: 'fill me in', color: 'sky' },
  { emoji: '🎧', label: 'on repeat', value: 'fill me in', color: 'lilac' },
  { emoji: '🌍', label: 'dream trip', value: 'fill me in', color: 'mint' },
  { emoji: '📺', label: 'comfort show', value: 'fill me in', color: 'peach' },
  { emoji: '✨', label: 'fun fact', value: 'fill me in', color: 'lemon' },
];
---

<BaseLayout title="about" description={`a little bit about ${SITE.author}, the person behind ${SITE.title}.`}>
  <section class="intro">
    <div class="art">
      <Avatar size={220} />
    </div>
    <div>
      <p class="kicker c-lemon">👋 about me</p>
      <h1>nice to <span class="highlight c-lemon">meet you!</span></h1>
      <p class="lead">
        i'm {SITE.author.toLowerCase()}, and this is my blog. this page is where you tell people who you are, what you're into,
        and why you started writing. a few sentences is plenty!
      </p>
    </div>
  </section>

  <section class="section">
    <h2>quick facts 🗂️</h2>
    <ul class="facts">
      {
        facts.map((fact) => (
          <li class:list={['fact', 'sticker', `c-${fact.color}`]}>
            <span class="fact-emoji" aria-hidden="true">
              {fact.emoji}
            </span>
            <span class="fact-label">{fact.label}</span>
            <span class="fact-value">{fact.value}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="section prose">
    <h2>why this blog?</h2>
    <p>
      a space for the story behind the blog: what made you want to start it, what you hope people take away from it,
      and what kinds of posts they can expect.
    </p>
    <h2>find me elsewhere</h2>
    <ul>
      {
        SOCIALS.map((s) => (
          <li>
            <a href={s.href}>{s.label}</a> {s.emoji}
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>

<style>
  .intro {
    display: grid;
    grid-template-columns: 240px 1fr;
    align-items: center;
    gap: 40px;
    padding-top: 48px;
  }

  .art {
    padding: 12px;
    animation: bob 5s ease-in-out infinite;
  }

  .facts {
    list-style: none;
    margin: 28px 0 0;
    padding: 0;
    display: grid;
    gap: 20px;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 220px), 1fr));
  }

  .fact {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 18px 20px;
  }

  .fact:nth-child(odd) {
    rotate: -1deg;
  }

  .fact:nth-child(even) {
    rotate: 1deg;
  }

  .fact-emoji {
    font-size: 1.8rem;
  }

  .fact-label {
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--ink-soft);
  }

  .fact-value {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.2rem;
  }

  .prose {
    margin-left: 0;
  }

  @media (max-width: 680px) {
    .intro {
      grid-template-columns: 1fr;
      text-align: center;
      padding-top: 24px;
    }

    .art {
      max-width: 200px;
      margin: 0 auto;
    }
  }
</style>
