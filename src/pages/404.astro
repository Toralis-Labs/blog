---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="page not found">
  <section class="lost">
    <p class="big" aria-hidden="true">🐾</p>
    <h1>oops! this page <span class="highlight c-peach">wandered off</span></h1>
    <p class="lead">it might have moved, or maybe it never existed at all. let's get you back somewhere cozy.</p>
    <a class="btn c-pink" href="/">take me home</a>
  </section>
</BaseLayout>

<style>
  .lost {
    max-width: 560px;
    margin: 0 auto;
    padding: 72px 0 24px;
    text-align: center;
  }

  .big {
    margin: 0;
    font-size: 5rem;
    line-height: 1.2;
    animation: wiggle 2s ease-in-out infinite;
  }

  .lead {
    margin-bottom: 32px;
  }
</style>
